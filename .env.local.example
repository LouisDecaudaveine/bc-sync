# Copy to .env.local and fill in.
#
# Open bandcamp.com in your browser while logged in, open DevTools → Application
# → Cookies → bandcamp.com, and copy the value of the `identity` cookie.
BANDCAMP_IDENTITY_COOKIE=

# Your numeric fan id. Visit your bandcamp profile page, view source, search for
# "fan_id" — it's the integer in the page bootstrap blob. Also visible in the
# URL of some fan API responses.
BANDCAMP_FAN_ID=

